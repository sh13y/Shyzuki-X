# ============================================================
# WhatsApp Bot Configuration
# Copy this file to .env and fill in your values
# ============================================================

# Optional: Phone number to login with 8-character Pairing Code instead of QR
# Country code + phone number, NO +, NO spaces (e.g. 94771234567)
# Leave empty if you prefer QR Code login
# BOT_PHONE_NUMBER=94771234567

# Phone number(s) to listen and reply to
# Format: country code + number, NO plus sign, NO spaces, NO dashes
# Example: 60123456789 for Malaysian number +60-12-345-6789
# To allow multiple numbers, separate with commas: 60123456789,60198765432
ALLOWED_NUMBERS=60123456789

# The reply message to send back when a message is received from an allowed number
REPLY_MESSAGE=Hello! This is an automated reply. I will get back to you shortly.

# Session backup directory (optional, default: .wwebjs_auth)
# SESSION_PATH=.wwebjs_auth
